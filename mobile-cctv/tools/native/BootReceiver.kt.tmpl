package __PKG__

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.os.Build
import android.provider.Settings

/**
 * Starts the camera after a reboot.
 *
 * Android 10 and older (the main target): the service starts straight from the
 * boot broadcast and brings the camera up with nothing on screen.
 * Android 11+: Android forbids starting a camera service from the boot
 * broadcast, so the app is opened instead (and a tap-to-start notification is
 * left as a fallback).
 */
class BootReceiver : BroadcastReceiver() {

    override fun onReceive(context: Context, intent: Intent) {
        val action = intent.action ?: return
        if (action != Intent.ACTION_BOOT_COMPLETED &&
            action != "android.intent.action.QUICKBOOT_POWERON" &&
            action != Intent.ACTION_MY_PACKAGE_REPLACED
        ) return

        val prefs = context.getSharedPreferences(Bridge.PREFS, Context.MODE_PRIVATE)
        if (!prefs.getBoolean(Bridge.KEY_AUTOSTART, true)) return

        if (Build.VERSION.SDK_INT <= 29) {
            try {
                CameraForegroundService.start(context, "Starting camera...")
                return
            } catch (e: Exception) {
                // fall through to launching the app
            }
        }

        val launch = context.packageManager.getLaunchIntentForPackage(context.packageName) ?: return
        launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        launch.putExtra(Bridge.EXTRA_AUTOSTART, true)

        try {
            val canLaunch = Build.VERSION.SDK_INT <= 28 ||
                (Build.VERSION.SDK_INT >= 23 && Settings.canDrawOverlays(context))
            if (canLaunch) context.startActivity(launch)
        } catch (e: Exception) {
        }

        postFallback(context, launch)
    }

    private fun postFallback(ctx: Context, launch: Intent) {
        val nm = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        if (Build.VERSION.SDK_INT >= 26) {
            nm.createNotificationChannel(
                NotificationChannel(
                    "digiforge_boot",
                    "Camera start after reboot",
                    NotificationManager.IMPORTANCE_HIGH
                )
            )
        }
        val pi = PendingIntent.getActivity(ctx, 2, launch, Bridge.piFlags())
        val b = if (Build.VERSION.SDK_INT >= 26) {
            Notification.Builder(ctx, "digiforge_boot")
        } else {
            Notification.Builder(ctx)
        }
        b.setContentTitle("DigiForge Camera")
        b.setContentText("Tap to start the camera after reboot")
        b.setSmallIcon(android.R.drawable.ic_menu_camera)
        b.setContentIntent(pi)
        b.setAutoCancel(true)
        nm.notify(Bridge.BOOT_NOTIF_ID, b.build())
    }
}
