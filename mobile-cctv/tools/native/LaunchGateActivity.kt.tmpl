package __PKG__

import android.app.Activity
import android.content.Context
import android.content.Intent
import android.os.Bundle

/**
 * The only launcher icon. It has no screen at all (Theme.NoDisplay):
 * - setup finished: make sure the background service is running and vanish at once,
 *   so tapping the icon never shows anything;
 * - setup not finished (first run): open the setup screen.
 */
class LaunchGateActivity : Activity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        val prefs = getSharedPreferences(Bridge.PREFS, Context.MODE_PRIVATE)
        val done = prefs.getBoolean(Bridge.KEY_SETUP_DONE, false) &&
            Bridge.granted(this, "android.permission.CAMERA") &&
            Bridge.granted(this, "android.permission.RECORD_AUDIO")

        if (done) {
            try {
                // Started from a visible activity, so Android allows the camera-type service.
                CameraForegroundService.start(this, "Ready - the camera turns on when you watch")
            } catch (e: Exception) {
            }
        } else {
            startActivity(Intent(this, MainActivity::class.java))
        }
        finish()
    }
}
