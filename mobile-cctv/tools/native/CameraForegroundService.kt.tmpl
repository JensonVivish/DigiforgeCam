package __PKG__

import android.app.AlarmManager
import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.app.Service
import android.content.Context
import android.content.Intent
import android.os.Build
import android.os.Handler
import android.os.IBinder
import android.os.Looper
import android.os.PowerManager
import android.os.Process

/**
 * Foreground service. Being a foreground service is what lets Android keep the
 * process alive and the camera open in the background. It also guarantees the
 * Flutter engine (which runs the camera + WebRTC code) is up, so it works even
 * when nothing is on screen, for example right after a reboot.
 */
class CameraForegroundService : Service() {

    private var wakeLock: PowerManager.WakeLock? = null

    override fun onBind(intent: Intent?): IBinder? = null

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        if (intent != null && intent.action == ACTION_STOP) {
            // "Stop" in the notification: end everything, including the camera.
            running = false
            stopForeground(true)
            stopSelf()
            // Give Android a moment to register the stop before the process ends,
            // otherwise START_STICKY could bring the service straight back.
            Handler(Looper.getMainLooper()).postDelayed({
                Process.killProcess(Process.myPid())
            }, 800)
            return START_NOT_STICKY
        }

        val text = intent?.getStringExtra(EXTRA_TEXT) ?: status
        status = text
        val notification = build(this, text)
        try {
            if (Build.VERSION.SDK_INT >= 30) {
                var types = 0
                if (Bridge.granted(this, "android.permission.CAMERA")) types = types or TYPE_CAMERA
                if (Bridge.granted(this, "android.permission.RECORD_AUDIO")) types = types or TYPE_MICROPHONE
                if (types != 0) {
                    startForeground(NOTIF_ID, notification, types)
                } else {
                    startForeground(NOTIF_ID, notification)
                }
            } else {
                startForeground(NOTIF_ID, notification)
            }
        } catch (e: Exception) {
            running = false
            stopSelf()
            return START_NOT_STICKY
        }
        running = true
        acquireWakeLock()

        // Make sure the Flutter engine exists (no-op if the Activity already made it).
        try {
            EngineHolder.get(applicationContext)
        } catch (e: Exception) {
        }
        return START_STICKY
    }

    override fun onTaskRemoved(rootIntent: Intent?) {
        super.onTaskRemoved(rootIntent)
        // Some phones stop the service when the app is swiped away from recents.
        // Ask Android to start it again a moment later.
        try {
            val i = Intent(applicationContext, CameraForegroundService::class.java)
            i.putExtra(EXTRA_TEXT, status)
            val pi = if (Build.VERSION.SDK_INT >= 26) {
                PendingIntent.getForegroundService(applicationContext, 3, i, Bridge.piFlags())
            } else {
                PendingIntent.getService(applicationContext, 3, i, Bridge.piFlags())
            }
            val am = getSystemService(Context.ALARM_SERVICE) as AlarmManager
            am.set(AlarmManager.RTC_WAKEUP, System.currentTimeMillis() + 1500, pi)
        } catch (e: Exception) {
        }
    }

    private fun acquireWakeLock() {
        if (wakeLock?.isHeld == true) return
        val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
        val wl = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "digiforge:camera")
        wl.setReferenceCounted(false)
        wl.acquire()
        wakeLock = wl
    }

    override fun onDestroy() {
        running = false
        try {
            if (wakeLock?.isHeld == true) wakeLock?.release()
        } catch (e: Exception) {
        }
        wakeLock = null
        super.onDestroy()
    }

    companion object {
        const val CHANNEL_ID = "digiforge_camera"
        const val NOTIF_ID = 1001
        const val ACTION_STOP = "com.digiforgedynamics.action.STOP_CAMERA"
        const val EXTRA_TEXT = "text"
        private const val TYPE_CAMERA = 0x40
        private const val TYPE_MICROPHONE = 0x80

        @Volatile
        var running = false

        @Volatile
        var status = "Camera is running"

        fun start(ctx: Context, text: String) {
            status = text
            val i = Intent(ctx, CameraForegroundService::class.java)
            i.putExtra(EXTRA_TEXT, text)
            if (Build.VERSION.SDK_INT >= 26) {
                ctx.startForegroundService(i)
            } else {
                ctx.startService(i)
            }
        }

        fun stopService(ctx: Context) {
            ctx.stopService(Intent(ctx, CameraForegroundService::class.java))
            running = false
        }

        fun update(ctx: Context, text: String) {
            status = text
            if (running) {
                val nm = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
                nm.notify(NOTIF_ID, build(ctx, text))
            }
        }

        private fun ensureChannel(ctx: Context) {
            if (Build.VERSION.SDK_INT >= 26) {
                val nm = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
                val ch = NotificationChannel(
                    CHANNEL_ID,
                    "Camera background mode",
                    NotificationManager.IMPORTANCE_LOW
                )
                nm.createNotificationChannel(ch)
            }
        }

        fun build(ctx: Context, text: String): Notification {
            ensureChannel(ctx)
            val launch = ctx.packageManager.getLaunchIntentForPackage(ctx.packageName)!!
            val open = PendingIntent.getActivity(ctx, 0, launch, Bridge.piFlags())
            val stopIntent = Intent(ctx, CameraForegroundService::class.java)
            stopIntent.action = ACTION_STOP
            val stop = PendingIntent.getService(ctx, 1, stopIntent, Bridge.piFlags())
            val b = if (Build.VERSION.SDK_INT >= 26) {
                Notification.Builder(ctx, CHANNEL_ID)
            } else {
                Notification.Builder(ctx)
            }
            b.setContentTitle("DigiForge Camera")
            b.setContentText(text)
            b.setSmallIcon(android.R.drawable.ic_menu_camera)
            b.setContentIntent(open)
            b.setOngoing(true)
            b.addAction(android.R.drawable.ic_menu_close_clear_cancel, "Stop", stop)
            return b.build()
        }
    }
}
